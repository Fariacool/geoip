# Copy this file to .env and adjust values before running ./compose up.

# ========== Docker Compose ==========

# Published HTTP port on the host.
HOST_PORT=8080

# Image to run. Override for local builds or pinned releases.
IMAGE_NAME=ghcr.io/fariacool/geoip:latest

# Docker network name.
COMPOSE_NETWORK_NAME=geoip

# ========== GeoIP Service ==========

# These match the Docker image defaults and normally do not need changes.
LISTEN_ADDR=0.0.0.0:8080
DATA_DIR=/data

# Comma-separated MaxMind database editions.
MAXMIND_EDITIONS=GeoLite2-City

# Optional, but useful for the web UI map.
OSM_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Auto-update intervals in hours. Set TZDATA_AUTO_UPDATE_INTERVAL=0 to disable
# timezone database auto-updates.
AUTO_UPDATE_INTERVAL=24
TZDATA_AUTO_UPDATE_INTERVAL=24

# ========== MaxMind Updates ==========

# Set these to enable automatic MaxMind database downloads.
# You can create free GeoLite2 credentials at:
# https://dev.maxmind.com/geoip/geolite2-free-geolocation-data/
# MAXMIND_ACCOUNT_ID=
# MAXMIND_LICENCE_KEY=

# Alternative: pull MMDB archives from another GeoIP service or mirror.
# Use {edition} as the edition placeholder.
# MAXMIND_DOWNLOAD_URL=https://download.maxmind.com/geoip/databases/{edition}/download?suffix=tar.gz
# MAXMIND_BEARER_TOKEN=

# ========== Access Control ==========

# Protect /api/geoip, /api/timezones, and /files/** with this bearer token.
# API_KEY=

# Optional Recaptcha v3 protection for /api/geoip.
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# ========== Optional Integrations ==========

# Override timezone database download source.
# TZDATA_DOWNLOAD_URL=https://data.iana.org/time-zones/tzdata-latest.tar.gz
# TZDATA_BEARER_TOKEN=

# Override zic binary path if needed.
# ZIC_PATH=/usr/sbin/zic

# Enable Google Analytics integration.
# GOOGLE_TAG_ID=
